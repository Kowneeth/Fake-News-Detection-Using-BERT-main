{
  "manifest_version": 3,
  "name": "Fake News Intelligence 2.0",
  "version": "2.0.0",
  "description": "Real-time AI fake news, clickbait, and disinformation detection for tweets, articles, and websites.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fake News Detector",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
